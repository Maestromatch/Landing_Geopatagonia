        {
            "id": "geo-car-007",
            "name": "Code - Expandir Items Geo",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2600,
                780
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const item = $input.first().json;\nconst fileIds = JSON.parse(item.fileIdsJson || '[]');\nconst caption = item.caption || '';\n\nif (!fileIds.length) throw new Error('No hay fileIds');\n\nreturn fileIds.map((fileId, index) => ({\n  json: {\n    fileId,\n    imageUrl: `https://drive.google.com/uc?export=download&id=${fileId}`,\n    caption\n  }\n}));"
            }
        },
