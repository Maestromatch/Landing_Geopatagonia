        {
            "id": "geo-car-003",
            "name": "Code - Filtrar Imagenes Geo",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1400,
                800
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const input = $input.first().json;\nconst files = input.files || [];\n\nconst imageFiles = files.filter(file => {\n  const name = (file.name || '').toLowerCase();\n  const mime = (file.mimeType || '');\n  return (\n    mime.startsWith('image/') ||\n    name.endsWith('.jpg') ||\n    name.endsWith('.png') ||\n    name.endsWith('.webp')\n  );\n});\n\nconst toProcess = imageFiles.slice(0, 10);\n\nreturn [{\n  json: {\n    count: toProcess.length,\n    fileIds: toProcess.map(f => f.id),\n    fileIdsJson: JSON.stringify(toProcess.map(f => f.id)),\n    firstFileName: (toProcess[0]?.name || 'Fundo Los Tres').replace(/\\.[^/.]+$/, ''),\n    allFileNames: toProcess.map(f => f.name).join(', ')\n  }\n}];"
            }
        },
