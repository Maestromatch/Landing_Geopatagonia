            "id": "geo-foto-006",
            "name": "TikTok - Publicar Foto Geo",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                2300,
                200
            ],
            "parameters": {
                "method": "POST",
                "url": "https://open.tiktokapis.com/v2/post/publish/content/init/",
                "sendHeaders": true,
                "headerParameters": {
                    "parameters": [
                        {
                            "name": "Authorization",
                            "value": "Bearer TU_TIKTOK_ACCESS_TOKEN_GEO"
                        },
                        {
                            "name": "Content-Type",
                            "value": "application/json; charset=UTF-8"
                        }
                    ]
                },
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"media_type\": \"PHOTO\",\n  \"post_info\": {\n    \"title\": {{ JSON.stringify($('IA Caption - Foto Geo').item.json.text.substring(0, 150)) }},\n    \"privacy_level\": \"PUBLIC_TO_EVERYONE\",\n    \"disable_duet\": false,\n    \"disable_comment\": false,\n    \"disable_stitch\": false\n  },\n  \"source_info\": {\n    \"source\": \"PULL_FROM_URL\",\n    \"photo_images\": [\"https://drive.google.com/uc?export=download&id={{ $('Trigger Fotos Geo').item.json.id }}\"],\n    \"photo_cover_index\": 0\n  }\n}",
                "options": {}
            }
        },
