        {
            "id": "geo-car-009",
            "name": "Code - Agregar IDs Geo",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                3200,
                780
            ],
            "parameters": {
                "mode": "runOnceForAllItems",
                "jsCode": "const items = $input.all();\nconst ids = items.map(item => item.json.id).filter(Boolean);\n\nlet caption = '';\ntry { caption = $('Set - Caption Geo').first().json.caption; } \ncatch(e) { caption = 'Nuevas parcelas disponibles #GeoPatagonia'; }\n\nreturn [{\n  json: {\n    children: ids.join(','),\n    caption,\n    itemIds: ids\n  }\n}];"
            }
        },
