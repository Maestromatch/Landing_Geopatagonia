            "type": "n8n-nodes-base.set",
            "typeVersion": 3,
            "position": [
                2300,
                780
            ],
            "parameters": {
                "mode": "manual",
                "duplicateItem": false,
                "assignments": {
                    "assignments": [
                        {
                            "id": "assign-caption",
                            "name": "caption",
                            "value": "={{ $json.text }}",
                            "type": "string"
