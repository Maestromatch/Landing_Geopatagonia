        {
            "id": "geo-car-002",
            "name": "Listar Archivos Carrusel Geo",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1100,
                800
            ],
            "parameters": {
                "method": "GET",
                "url": "https://www.googleapis.com/drive/v3/files",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "googleDriveOAuth2Api",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "q",
                            "value": "'TU_CARPETA_CARRUSEL_GEO_AQUI' in parents and trashed = false"
                        },
                        {
                            "name": "fields",
                            "value": "files(id,name,mimeType)"
                        },
                        {
                            "name": "orderBy",
                            "value": "createdTime"
                        }
                    ]
                },
                "options": {}
            },
            "credentials": {
                "googleDriveOAuth2Api": {
                    "id": "uqdx7FMLohZVyoTl",
                    "name": "Google Drive OAuth2 API"
