                "url": "https://graph.facebook.com/v20.0/TU_IG_ACCOUNT_ID/media",
                "sendQuery": true,
                "queryParameters": {
                    "parameters": [
                        {
                            "name": "access_token",
                            "value": "TU_IG_ACCESS_TOKEN_GEO"
                        },
                        {
                            "name": "image_url",
                            "value": "=https://drive.google.com/uc?export=download&id={{ $('Trigger Fotos Geo').item.json.id }}"
